# ==========================================================================
# BillionMail — perfil "somente ENVIO via API", rodando em paralelo ao CapRover
# Copie para .env na VPS:  cp .env.billionmail.example .env
# Use junto com:           docker compose -f docker-compose.billionmail.yml up -d
# ==========================================================================

# --- Acesso ao painel admin -------------------------------------------------
# Login inicial. TROQUE a senha no primeiro acesso pela UI.
ADMIN_USERNAME=billion
ADMIN_PASSWORD=FJtCu2j57H1TnJ3DEe4k

# "Entrada segura" do painel. O painel só responde em /<SafePath>.
# Ex.: https://SEU_IP:8443/billion-a1b2  (troque por algo difícil de adivinhar)
SafePath=billion-d3965920

# --- Hostname de email ------------------------------------------------------
# IMPORTANTE: troque pelo SEU hostname de email. NUNCA use o domínio nu.
# O rDNS/PTR do IP da VPS deve apontar para este mesmo nome.
BILLIONMAIL_HOSTNAME=mail.seudominio.com

# --- PostgreSQL -------------------------------------------------------------
DBNAME=billionmail
DBUSER=billionmail
DBPASS=63c89b5b6e48a941433f213acc29b6d73626249ba28ea006

# --- Redis ------------------------------------------------------------------
REDISPASS=5dd1933a4ae6af33dc98e3b88d57e2534a5b70be31b5a2a8

# --- Portas de EMAIL --------------------------------------------------------
# 25 = entrega de saída + recebimento de bounces. As demais ficam só internas
# (sem dovecot não há submission autenticada externa neste perfil).
SMTP_PORT=25

# --- Portas do PAINEL (NÃO use 80/443: são do CapRover) ---------------------
# Painel acessível em https://SEU_IP:8443/<SafePath>
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Bancos só em localhost (não expor à internet) --------------------------
REDIS_PORT=127.0.0.1:26379
SQL_PORT=127.0.0.1:25432

# --- Geral ------------------------------------------------------------------
TZ=America/Sao_Paulo

# Sub-rede interna dos containers. Se 172.66.1.0/24 colidir com algo no host
# (inclusive redes do CapRover/Swarm), troque para uma faixa livre, ex. 172.77.1
IPV4_NETWORK=172.66.1

# fail2ban dentro do container core
FAIL2BAN_INIT=y

# Whitelist de IP para o console (false = desabilitado)
IP_WHITELIST_ENABLE=false

# Dias de retenção de logs
RETENTION_DAYS=7
